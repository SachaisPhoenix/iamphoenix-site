<style>
  :root {
    --red: #E30022;
    --gold: #FFD100;
    --ink: #1A1A1A;
    --ink-soft: #3A3A3A;
    --cream: #FDFBF7;
    --cream-2: #F5F0E6;
    --rule: #E6DFD0;
    --serif: 'Fraunces', Georgia, serif;
    --sans: 'Inter', -apple-system, system-ui, sans-serif;
    --max: 1180px;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    font-family: var(--sans);
    color: var(--ink);
    background: var(--cream);
    line-height: 1.55;
    font-size: 17px;
  }
  img, video { max-width: 100%; height: auto; display: block; }
  a { color: var(--ink); }
  a:hover { color: var(--red); }

  /* Header */
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: var(--cream);
    border-bottom: 1px solid var(--rule);
  }
  .nav {
    max-width: var(--max);
    margin: 0 auto;
    padding: 14px 28px;
    display: flex; align-items: center; justify-content: space-between;
    gap: 24px;
  }
  .logo { display: inline-flex; align-items: center; }
  .logo img { height: 72px; width: auto; display: block; }
  @media (max-width: 720px) {
    .logo img { height: 56px; }
  }
  .nav-links { display: flex; gap: 28px; font-family: var(--sans); font-size: 14px; font-weight: 500; letter-spacing: 0.5px; text-transform: uppercase; }
  .nav-links a { text-decoration: none; }
  .nav-links a.active { color: var(--red); }
  .nav-cta { font-size: 14px; padding: 10px 18px; background: var(--ink); color: var(--cream); border-radius: 999px; text-decoration: none; font-weight: 600; }
  .nav-cta:hover { background: var(--red); color: var(--cream); }
  .nav-toggle {
    display: none;
    background: transparent;
    border: 0;
    width: 44px; height: 44px;
    padding: 0;
    cursor: pointer;
  }
  .nav-toggle span {
    display: block;
    width: 24px; height: 2px;
    background: var(--ink);
    margin: 5px auto;
    transition: transform 0.25s ease, opacity 0.2s ease;
  }
  .nav-toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .nav-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .nav-toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  @media (max-width: 720px) {
    .nav { justify-content: flex-start; gap: 8px; }
    .nav-cta { font-size: 13px; padding: 8px 14px; margin-left: auto; }
    .nav-toggle { display: block; }
    .nav-links {
      position: absolute;
      top: 100%; left: 0; right: 0;
      flex-direction: column;
      gap: 0;
      background: var(--cream);
      border-bottom: 1px solid var(--rule);
      box-shadow: 0 14px 26px rgba(0,0,0,0.08);
      padding: 8px 28px 20px;
      transform: translateY(-110%);
      transition: transform 0.3s ease;
      visibility: hidden;
      z-index: 49;
    }
    .nav-links.open { transform: translateY(0); visibility: visible; }
    .nav-links a {
      padding: 14px 0;
      border-bottom: 1px solid var(--rule);
      font-size: 15px;
    }
    .nav-links a:last-child { border-bottom: 0; }
  }

  /* Hero */
  .hero {
    position: relative;
    min-height: 78vh;
    display: flex; align-items: flex-end;
    background: var(--ink);
    overflow: hidden;
  }
  .hero img {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: 0.85;
  }
  .hero::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(to right, rgba(26,26,26,0.78) 0%, rgba(26,26,26,0.55) 35%, rgba(26,26,26,0.15) 65%, rgba(26,26,26,0) 90%);
    z-index: 1;
    pointer-events: none;
  }
  .hero-overlay {
    position: relative; z-index: 2;
    width: 100%;
    max-width: var(--max);
    margin: 0 auto;
    padding: 60px 28px 80px;
    color: var(--cream);
  }
  .hero h1 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(40px, 6vw, 76px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 24px;
    max-width: 18ch;
  }
  .hero p {
    font-size: clamp(17px, 1.6vw, 21px);
    line-height: 1.5;
    max-width: 42ch;
    margin: 0 0 32px;
    opacity: 0.92;
  }
  .btn-primary {
    display: inline-block;
    padding: 16px 32px;
    background: var(--gold);
    color: var(--ink);
    text-decoration: none;
    border-radius: 999px;
    font-weight: 600;
    font-size: 16px;
    letter-spacing: 0.3px;
    transition: transform 0.15s ease;
  }
  .btn-primary:hover { transform: translateY(-2px); color: var(--ink); }

  /* Section base */
  section { padding: 90px 28px; }
  .container { max-width: var(--max); margin: 0 auto; }
  .eyebrow {
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--red);
    margin: 0 0 16px;
  }
  h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0 0 24px;
  }
  h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(24px, 2.4vw, 32px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0 0 12px;
  }
  p { margin: 0 0 16px; }

  /* Featured quote */
  .quote-section { background: var(--cream-2); }
  .quote {
    max-width: 880px; margin: 0 auto;
    text-align: center;
  }
  .quote blockquote {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(22px, 2.6vw, 32px);
    line-height: 1.35;
    margin: 0 0 28px;
    color: var(--ink);
  }
  .quote blockquote::before {
    content: '"';
    font-family: var(--serif);
    font-size: 80px;
    line-height: 0.5;
    color: var(--gold);
    display: block;
    margin-bottom: 24px;
  }
  .quote .attr {
    font-family: var(--sans);
    font-size: 14px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .quote .attr strong { color: var(--ink); font-weight: 600; }

  /* What I bring */
  .intro { max-width: 760px; margin: 0 auto; text-align: center; }
  .intro p { font-size: 19px; line-height: 1.6; color: var(--ink-soft); }

  /* Talks */
  .talks { background: var(--cream); }
  .talk {
    border-top: 1px solid var(--rule);
    padding: 48px 0;
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 48px;
    align-items: start;
  }
  .talk:last-child { border-bottom: 1px solid var(--rule); }
  .talk-num {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: 64px;
    color: var(--red);
    line-height: 1;
  }
  .talk h3 { margin-top: 0; }
  .talk p { color: var(--ink-soft); margin-bottom: 16px; }
  .best-for {
    font-family: var(--sans);
    font-size: 14px;
    color: var(--ink-soft);
    border-top: 1px solid var(--rule);
    padding-top: 14px;
    margin-top: 18px;
  }
  .talk-quote {
    margin: 24px 0 0;
    padding: 22px 26px;
    background: var(--cream-2);
    border-left: 3px solid var(--gold);
    border-radius: 4px;
  }
  .talk-quote p {
    font-family: var(--serif);
    font-style: italic;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink);
    margin: 0 0 12px;
  }
  .talk-quote cite {
    display: block;
    font-family: var(--sans);
    font-style: normal;
    font-size: 12px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 500;
  }
  .talk-quote cite strong { color: var(--ink); font-weight: 600; }
  .best-for strong {
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 12px;
    font-weight: 600;
    display: block;
    margin-bottom: 6px;
  }
  @media (max-width: 720px) {
    .talk { grid-template-columns: 1fr; gap: 16px; }
    .talk-num { font-size: 48px; }
  }

  /* Video */
  .video-section { background: var(--ink); color: var(--cream); }
  .video-section h2 { color: var(--cream); text-align: center; }
  .video-section .eyebrow { color: var(--gold); text-align: center; }
  .video-wrap {
    max-width: 960px; margin: 32px auto 0;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 30px 60px rgba(0,0,0,0.5);
  }
  .video-wrap video,
  .video-wrap iframe {
    width: 100%;
    display: block;
    border: 0;
  }
  .video-wrap iframe {
    aspect-ratio: 16 / 9;
    height: auto;
  }
  .video-caption a {
    color: var(--gold);
    text-decoration: underline;
    font-weight: 600;
  }
  .video-caption a:hover { color: var(--cream); }
  .video-caption {
    text-align: center;
    margin-top: 20px;
    font-size: 14px;
    opacity: 0.7;
    letter-spacing: 0.5px;
  }

  /* Logo strip */
  .logos {
    background: var(--cream);
    padding: 60px 28px;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .logos .container { text-align: center; }
  .logos .eyebrow { margin-bottom: 32px; }
  .logo-strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 28px 36px;
  }
  .logo-cell {
    width: 150px;
    height: 70px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
  }
  .logo-cell img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: saturate(0.85) opacity(0.85);
    transition: filter 0.2s;
  }
  .logo-cell img:hover {
    filter: saturate(1) opacity(1);
  }
  @media (max-width: 720px) {
    .logo-cell { width: 120px; height: 60px; }
  }

  /* About */
  .about {
    background: var(--cream-2);
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 64px;
    align-items: center;
    max-width: var(--max);
    margin: 0 auto;
    padding: 90px 28px;
  }
  .about-photo {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 8px;
    background: var(--rule);
  }
  .about-photo img { width: 100%; height: 100%; object-fit: cover; }
  .about-photo-wrap { display: block; }
  .about-text h2 { margin-bottom: 28px; }
  .about-text p { color: var(--ink); margin-bottom: 20px; line-height: 1.65; }
  .about-text em { font-family: var(--serif); }
  @media (max-width: 880px) {
    .about { grid-template-columns: 1fr; gap: 32px; }
  }

  /* Recent writing */
  .writing { background: var(--cream); }
  .writing .container { max-width: 980px; }
  .writing h2 { text-align: center; }
  .writing-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    margin-top: 40px;
  }
  .column-card {
    border: 1px solid var(--rule);
    padding: 32px;
    border-radius: 8px;
    background: var(--cream);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .column-card:hover { transform: translateY(-3px); box-shadow: 0 14px 30px rgba(0,0,0,0.06); }
  .column-meta {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--red);
    margin-bottom: 14px;
    font-weight: 600;
  }
  .column-card h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 22px;
    line-height: 1.3;
    margin-bottom: 16px;
  }
  .column-card a {
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    color: var(--red);
    border-bottom: 2px solid var(--gold);
    padding-bottom: 2px;
  }
  .column-card a:hover { border-bottom-color: var(--red); }
  @media (max-width: 720px) {
    .writing-grid { grid-template-columns: 1fr; }
  }

  /* Book section */
  .book-section {
    background: var(--ink);
    color: var(--cream);
    text-align: center;
  }
  .book-section h2 { color: var(--cream); }
  .book-section p { color: rgba(253, 251, 247, 0.85); max-width: 540px; margin: 0 auto 32px; font-size: 19px; }
  .book-section .btn-primary { background: var(--gold); color: var(--ink); }
  .book-cta-row { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
  .btn-secondary {
    display: inline-block;
    padding: 16px 32px;
    background: transparent;
    color: var(--cream);
    border: 2px solid var(--cream);
    border-radius: 4px;
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 16px;
    text-decoration: none;
    transition: background 0.2s, color 0.2s;
  }
  .btn-secondary:hover { background: var(--cream); color: var(--ink); }
  .book-fee { margin-top: 32px; font-size: 14px; opacity: 0.7; letter-spacing: 0.5px; }

  /* Footer */
  footer {
    padding: 40px 28px;
    background: var(--ink);
    color: rgba(253, 251, 247, 0.6);
    text-align: center;
    font-size: 13px;
    border-top: 1px solid rgba(255,255,255,0.08);
  }
  footer a { color: rgba(253, 251, 247, 0.8); text-decoration: none; }
  footer a:hover { color: var(--gold); }
  .photo-credit {
    display: block;
    font-family: var(--sans);
    font-size: 11px;
    font-style: italic;
    color: var(--ink-soft);
    letter-spacing: 0.4px;
    opacity: 0.65;
    margin-top: 10px;
  }
  .hero-credit {
    position: absolute;
    bottom: 14px;
    right: 22px;
    font-family: var(--sans);
    font-size: 11px;
    font-style: italic;
    color: var(--cream);
    letter-spacing: 0.4px;
    opacity: 0.55;
    z-index: 3;
    pointer-events: none;
  }
</style>
